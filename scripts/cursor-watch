#!/usr/bin/env python3
"""Stream the global cursor position, one "x y" line per change.

Hyprland has no pointer-motion event on its sockets, so this polls the
request socket directly (one short-lived connection per sample, no hyprctl
fork). The plugin only runs it while a picture-in-picture window exists.

usage: cursor-watch [interval-ms]
"""
import os
import socket
import sys
import time


def main():
    interval = max(5, int(sys.argv[1]) if len(sys.argv) > 1 else 33) / 1000
    path = "%s/hypr/%s/.socket.sock" % (
        os.environ["XDG_RUNTIME_DIR"],
        os.environ["HYPRLAND_INSTANCE_SIGNATURE"],
    )
    last = None
    while True:
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
                sock.connect(path)
                sock.sendall(b"cursorpos")
                reply = sock.recv(64).decode()
            x, y = (int(part) for part in reply.split(","))
        except (OSError, ValueError):
            time.sleep(1)
            continue
        if (x, y) != last:
            last = (x, y)
            sys.stdout.write("%d %d\n" % (x, y))
            sys.stdout.flush()
        time.sleep(interval)


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, BrokenPipeError):
        pass
